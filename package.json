{
  "name": "cortexia-island",
  "version": "0.1.0-alpha.8",
  "description": "An OLED black desktop island for PC electricity, estimated cost and live network health.",
  "author": "GhostFelina",
  "license": "MIT",
  "main": "out/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/GhostFelina/cortexia-island.git"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5371 --strictPort",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.main.json && node --test out/tests/core.test.js",
    "smoke": "npm run build && electron . --smoke",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "check": "npm run typecheck && npm test && npm run build",
    "version": "node scripts/sync-version.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "read-excel-file": "9.3.10",
    "systeminformation": "5.33.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "lucide": "1.52.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "dev.ghostfelina.cortexiaisland",
    "productName": "Cortexia Island",
    "artifactName": "Cortexia-Island-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "out/main/**/*",
      "out/shared/**/*",
      "dist/**/*",
      "assets/*.png",
      "assets/integrations/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "GhostFelina",
        "repo": "cortexia-island",
        "releaseType": "prerelease",
        "channel": "alpha"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "hardenedRuntime": true
    },
    "dmg": {
      "title": "Cortexia Island ${version}"
    }
  }
}
